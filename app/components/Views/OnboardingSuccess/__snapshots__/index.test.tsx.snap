exports[`OnboardingSuccess route params successFlow is NO_BACKED_UP_SRP renders matching snapshot with route params backedUpSRP true and noSRP false 1`] = `
<RCTScrollView
  contentContainerStyle={
    [
      {
        "flexGrow": 1,
        "paddingBottom": 32,
      },
    ]
  }
  testID="onboarding-success-screen"
>
  <View>
    <View
      style={
        {
          "flexDirection": "column",
          "flexGrow": 1,
          "justifyContent": "space-between",
          "rowGap": 16,
        }
      }
    >
      <View
        style={
          {
            "flex": 1,
            "paddingHorizontal": 16,
          }
        }
      >
        <Text
          accessibilityRole="text"
          style={
            {
              "color": "#121314",
              "fontFamily": "Geist Bold",
              "fontSize": 32,
              "letterSpacing": 0,
              "lineHeight": 40,
              "marginBottom": 24,
            }
          }
        >
          Your wallet is ready!
        </Text>
        <View
          style={
            {
              "alignItems": "center",
              "display": "flex",
              "height": 200,
              "justifyContent": "center",
              "marginHorizontal": "auto",
              "padding": 20,
              "width": 200,
            }
          }
        >
          <LottieAnimationView
            autoPlay={true}
            cacheComposition={true}
            colorFilters={[]}
            enableMergePathsAndroidForKitKatAndAbove={false}
            loop={true}
            onAnimationFailure={[Function]}
            onAnimationFinish={[Function]}
            onAnimationLoaded={[Function]}
